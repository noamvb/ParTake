[Unit]
Description=ParTake Deck server
After=network.target partake-watch-api.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/partake/server/partake_server.py --root %h/partake/web --host 0.0.0.0 --port 8797 --watch-upstream http://127.0.0.1:8798
Restart=on-failure
RestartSec=5
MemoryMax=150M

[Install]
WantedBy=default.target
