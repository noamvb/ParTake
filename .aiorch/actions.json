{
  "v": 1,
  "actions": [
    {
      "id": "push-main",
      "adapter": "git_push",
      "description": "Fast-forward push of local main to origin/main",
      "remote": "origin",
      "branch": "main"
    },
    {
      "id": "push-tag-v0-3-0",
      "adapter": "registered_workflow",
      "description": "Push release tag v0.3.0 (must point at origin/main) to origin; starts release.yml",
      "data_changing": false,
      "stages": {
        "preflight": [
          {
            "id": "tag-is-main-tip",
            "argv": [
              "sh",
              "-c",
              "git fetch -q origin main && test \"$(git rev-parse v0.3.0^{commit})\" = \"$(git rev-parse origin/main)\""
            ],
            "cwd": ".",
            "timeout_seconds": 60
          },
          {
            "id": "tag-not-on-remote",
            "argv": [
              "sh",
              "-c",
              "! git ls-remote --exit-code origin refs/tags/v0.3.0"
            ],
            "cwd": ".",
            "timeout_seconds": 60
          }
        ],
        "recovery_rehearsal": [],
        "backup": [],
        "action": [
          {
            "id": "push-tag",
            "argv": [
              "git",
              "push",
              "origin",
              "refs/tags/v0.3.0"
            ],
            "cwd": ".",
            "timeout_seconds": 120
          }
        ],
        "verification": [
          {
            "id": "remote-tag-matches",
            "argv": [
              "sh",
              "-c",
              "test \"$(git ls-remote origin refs/tags/v0.3.0^{} | cut -f1)\" = \"$(git rev-parse v0.3.0^{commit})\""
            ],
            "cwd": ".",
            "timeout_seconds": 60
          }
        ],
        "recovery": [
          {
            "id": "show-remote-tag",
            "argv": [
              "git",
              "ls-remote",
              "origin",
              "refs/tags/v0.3.0"
            ],
            "cwd": ".",
            "timeout_seconds": 60
          }
        ]
      },
      "recovery_description": "A pushed tag is not rolled back automatically. If the release run fails, fix forward with a higher version; delete the tag on GitHub only with the owner's OK."
    },
